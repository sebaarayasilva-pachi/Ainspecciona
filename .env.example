# Local: usa docker compose up -d y luego DATABASE_URL con localhost:3306
DATABASE_URL="mysql://ainspecta:ainspecta2026@localhost:3306/ainspecta"
# URL pública del sitio (emails de invitación: enlace /activate). Obligatorio en producción si el API se llama vía *.run.app.
# PUBLIC_URL="https://ainspecciona.web.app"
# Si no defines PUBLIC_URL y el servidor solo ve Host *.run.app, se usa WEB_APP_ORIGIN para armar el mail (evita enlaces bloqueados por el correo).
# WEB_APP_ORIGIN="https://ainspecciona.web.app"
# Tras crear la clave en /activate: 2.º mail con enlace a la app (si falta SMTP, /activate lo indica).
# Ficha pública (prioridad en el 2.º mail si está definida):
# EXECUTIVE_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.ainspecta.capture"
# Solo prueba interna (2.º mail) si NO hay EXECUTIVE_PLAY_STORE_URL:
# GOOGLE_PLAY_INTERNAL_TEST_URL="https://play.google.com/apps/internaltest/..."
OPENAI_API_KEY="your-openai-api-key"
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"
HUBSPOT_ACCESS_TOKEN="your-hubspot-private-app-token"
HUBSPOT_AGENDAR_URL="https://meetings.hubspot.com/tu-usuario"
HUBSPOT_COMPANY_RUT_PROPERTY="rut_empresa"
TRIAL_DURATION_DAYS="14"
TRIAL_INITIAL_REAL_INSPECTIONS="1"
# Admin: clave mínima al guardar corredora (default 6). Usa 2 solo en entornos de prueba si necesitas claves como "12".
# ADMIN_TENANT_PASSWORD_MIN_LEN="2"
OPENAI_MODEL="gpt-4.1-mini"
# Email del proveedor presencial (opcional; se puede editar en Admin → Proveedores)
# PRESENCIAL_SUPPLIER_EMAIL="paulo@ejemplo.cl"
# SMTP: Gmail (smtp.gmail.com:587, contraseña de aplicación en myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu@gmail.com"
SMTP_PASS="contraseña-de-aplicacion"