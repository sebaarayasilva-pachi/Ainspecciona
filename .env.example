# Local: usa docker compose up -d y luego DATABASE_URL con localhost:3306
DATABASE_URL="mysql://ainspecta:ainspecta2026@localhost:3306/ainspecta"
# URL pública del sitio (emails de invitación: enlace /activate). Obligatorio en producción si el API se llama vía *.run.app.
# PUBLIC_URL="https://ainspecciona.web.app"
# Si no defines PUBLIC_URL y el servidor solo ve Host *.run.app, se usa WEB_APP_ORIGIN para armar el mail (evita enlaces bloqueados por el correo).
# WEB_APP_ORIGIN="https://ainspecciona.web.app"
# Tras crear la clave en /activate: 2.º mail con enlace a la app (si falta SMTP, /activate lo indica).
# Ficha pública (prioridad en el 2.º mail si está definida):
# EXECUTIVE_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.ainspecta.capture"
# App Store (iPhone/iPad): bloque iOS en correo y /activate; si falta, fallback guía PWA
# EXECUTIVE_APP_STORE_URL="https://apps.apple.com/cl/app/ainspecciona-capture/id6763187024"
# Agente de voz ElevenLabs en home (/). Crear agente en elevenlabs.io → copiar Agent ID → allowlist: ainspecciona.com, localhost
# ELEVENLABS_AGENT_ID="agent_xxxxxxxx"
# ELEVENLABS_WIDGET_VARIANT="expanded"
# ELEVENLABS_WIDGET_DISMISSIBLE="1"
# Solo prueba interna (2.º mail) si NO hay EXECUTIVE_PLAY_STORE_URL:
# GOOGLE_PLAY_INTERNAL_TEST_URL="https://play.google.com/apps/internaltest/..."
OPENAI_API_KEY="your-openai-api-key"
# Producción: Access Token de la aplicación en Mercado Pago Developers (suele empezar por APP_USR-). Sandbox: TEST-...
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"
# Opcional si más adelante el front usa Bricks/SDK: clave pública de producción (pk_live_...) o prueba (TEST-...)
# MERCADOPAGO_PUBLIC_KEY=
# URL pública del sitio (back_urls de MP, emails). El webhook de MP debe ir al backend (Cloud Run), no solo al front.
# MERCADOPAGO_WEBHOOK_BASE_URL="https://ainspecciona-api-l65qd3mxja-tl.a.run.app"
# Si no defines MERCADOPAGO_WEBHOOK_BASE_URL, deploy.ps1 la rellena con la URL del servicio Cloud Run.
# Solo pruebas: con demo=1 en POST /api/starter/simulate-payment + datos de facturación, emite boleta SimpleFactura sin MP (quitar en producción).
# ALLOW_SIMULATE_SIMPLEFACTURA=1
HUBSPOT_ACCESS_TOKEN="your-hubspot-private-app-token"
# Reuniones comerciales (Starter/corporativo; mismo enlace usa el playbook del bot WhatsApp)
HUBSPOT_AGENDAR_URL="https://meetings.hubspot.com/saraya-silva"
HUBSPOT_COMPANY_RUT_PROPERTY="rut_empresa"
TRIAL_DURATION_DAYS="14"
TRIAL_INITIAL_REAL_INSPECTIONS="1"
# Admin: clave mínima al guardar corredora (default 6). Usa 2 solo en entornos de prueba si necesitas claves como "12".
# ADMIN_TENANT_PASSWORD_MIN_LEN="2"
OPENAI_MODEL="gpt-4.1-mini"
# Email del proveedor presencial (opcional; se puede editar en Admin → Proveedores)
# PRESENCIAL_SUPPLIER_EMAIL="paulo@ejemplo.cl"
# SMTP: Gmail (smtp.gmail.com:587, contraseña de aplicación en myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu@gmail.com"
SMTP_PASS="contraseña-de-aplicacion"

# WhatsApp (360dialog o Meta Cloud API). Webhook: GET/POST /api/whatsapp/webhook
# WHATSAPP_VERIFY_TOKEN="token-que-configuras-en-el-panel"
# WHATSAPP_APP_SECRET="App Secret (firma X-Hub-Signature-256)"
# WHATSAPP_ACCESS_TOKEN="token de envío"
# WHATSAPP_PHONE_NUMBER_ID="id del número"
# Opcional: base distinta (ej. 360dialog); por defecto graph.facebook.com/v21.0
# WHATSAPP_API_BASE="https://graph.facebook.com/v21.0"
# Página pública /whatsapp-test (sin login) y POST /api/whatsapp/test/simulate — compartir URL con el equipo; solo entornos de prueba
# WHATSAPP_TEST_MODE="1"
# Opcional: si está definida, la API de prueba exige la misma clave (header X-WhatsApp-Test-Secret o Authorization: Bearer). Recomendado en producción.
# WHATSAPP_TEST_SECRET="una-clave-larga-compartida-con-el-equipo"
# Plantilla aprobada en Meta (reenganche si falla texto por ventana 24h, error 131047)
# WHATSAPP_TEMPLATE_NAME="nombre_plantilla"
# WHATSAPP_TEMPLATE_REENGAGEMENT_NAME="nombre_plantilla_reenganche"
# WHATSAPP_TEMPLATE_LANG="es"
# OpenAI en WhatsApp (deshabilitar con WHATSAPP_OPENAI=0)
# WHATSAPP_OPENAI_MAX_TOKENS="512"
# WHATSAPP_OPENAI_TEMPERATURE="0.4"
# Base de conocimiento del bot (FAQ, comercial, políticas). Por defecto ya se usa config/whatsapp-knowledge.txt si no defines nada.
# Para otro archivo o ruta absoluta:
# WHATSAPP_BOT_KNOWLEDGE_PATH="config/whatsapp-knowledge.txt"
# Para no cargar archivo (solo playbook en código):
# WHATSAPP_BOT_KNOWLEDGE_PATH="off"
# Texto corto extra en .env (opcional; se añade después del archivo si ambos están definidos)
# WHATSAPP_BOT_KNOWLEDGE=""
# Texto opcional añadido al system prompt del bot (operador: políticas, tono, casos especiales)
# WHATSAPP_BOT_EXTRA_INSTRUCTIONS=""
# Una línea opcional sobre contacto humano (ej. horario de ejecutivos); se inyecta junto a la palabra clave *humano*
# WHATSAPP_BOT_SUPPORT_NOTE="Ejecutivos responden lun–vie 9:00–18:00 hora Chile."

# --- PropertyCheck → API v0 (POST /api/v0/tenants/:tenantId/propertycheck/analyze) ---
# Secreto compartido: header `x-propertycheck-secret`. Llamar solo server-to-server (no exponer en front).
# PROPERTYCHECK_INGRESS_SECRET="genera-una-cadena-larga"
# Tamaño máximo por imagen (bytes). Default ~15MB.
# PROPERTYCHECK_MAX_IMAGE_BYTES=15728640
# Máximo de fotos por POST. Default 40.
# PROPERTYCHECK_MAX_PHOTOS_PER_REQUEST=40

# --- Postventa inmobiliaria (ElevenLabs agent + API /api/postventa/agent/*) ---
# API key ElevenLabs (Profile → API Keys) — sync prompt desde Cursor: npm run sync:elevenlabs-postventa
# ELEVENLABS_API_KEY="sk_xxxxxxxx"
# Mismo valor que configuras en ElevenLabs → header x-postventa-agent-secret
# POSTVENTA_AGENT_SECRET="genera-una-cadena-larga"
# Maqueta demo: 1 = acepta cualquier dirección y garantía vigente; 0 = catálogo real
# POSTVENTA_DEMO_ACCEPT_ANY_ADDRESS="1"
# Agente dedicado postventa (distinto al de marketing home)
# ELEVENLABS_POSTVENTA_AGENT_ID="agent_xxxxxxxx"
# Opcional si usas branch: ELEVENLABS_POSTVENTA_BRANCH_ID="agtbrch_xxxxxxxx"
# ELEVENLABS_POSTVENTA_WIDGET_VARIANT="expanded"
# ELEVENLABS_POSTVENTA_WIDGET_DISMISSIBLE="1"