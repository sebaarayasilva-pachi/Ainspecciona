  accuracyPct          Float
  slotCodes            Json?
  createdAt            DateTime         @default(now())

  @@index([createdAt])
  @@index([caseId])
  @@index([tenantId])
  @@index([source])
  @@map("ai_report_correction")
}

enum KnowledgeEntryType {
  finding_example
  anti_example
  correction
  ticket_learning
}

enum KnowledgeEntryStatus {
  candidate
  approved
  rejected
  disabled
}

/// KB unificada (RAG): conocimiento aprendido de inspecciones, postventa y Property-chk.
model KnowledgeEntry {
  id             String               @id @default(uuid())
  tenantId       String?
  source         AiFeedbackSource
  entryType      KnowledgeEntryType
  status         KnowledgeEntryStatus @default(candidate)

  kpiKey         String?              @db.VarChar(64)
  category       String?              @db.VarChar(64)
  severity       String?              @db.VarChar(16)

  /// Texto canónico: se embebe y se inyecta en prompts.
  text           String               @db.Text
  /// Snapshot estructurado de la fuente (IA vs humano, contexto).
  payload        Json?
  /// Referencia al origen: caseId/slotId, ticketId, feedbackId.
  sourceRef      String?              @db.VarChar(191)
  fingerprint    String               @unique @db.VarChar(64)

  embedding      Json?
  embeddingModel String?              @db.VarChar(64)

  createdBy      String?              @db.VarChar(255)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([source, entryType])
  @@index([kpiKey])
  @@index([category])
  @@index([tenantId])
  @@map("knowledge_entry")
}

/// Veredicto ITO por slot. Si verdict=corrected, también se aplica al Slot del informe
/// (análisis IA original queda en analysisDebug.aiBeforeHumanReview).
model SlotReview {
  id            String   @id @default(uuid())
  slotId        String   @unique
  caseId        String
  /// 'ok' | 'corrected'
  verdict       String   @db.VarChar(16)

  humanCode     String?  @db.VarChar(64)
  humanSeverity String?  @db.VarChar(16)
  humanMessage  String?  @db.Text
  humanKpiKey   String?  @db.VarChar(64)
  note          String?  @db.Text

  reviewerEmail String?  @db.VarChar(255)
  reviewedAt    DateTime @default(now())

  @@index([caseId])
  @@map("slot_review")
}

/// Veredicto ITO por hallazgo del análisis IA de un ticket postventa.
model PvAnalysisReview {
  id            String   @id @default(uuid())
  ticketId      String
  analysisId    String?
  /// slotCode del informe IA al que aplica el veredicto; null = veredicto global del ticket.
  slotCode      String?  @db.VarChar(64)
  /// 'ok' | 'corrected'
  verdict       String   @db.VarChar(16)

  humanCategory String?  @db.VarChar(64)
  humanSeverity String?  @db.VarChar(16)
  humanMessage  String?  @db.Text
  note          String?  @db.Text

  reviewerEmail String?  @db.VarChar(255)
  reviewedAt    DateTime @default(now())

  @@unique([ticketId, analysisId, slotCode])
  @@index([ticketId])
  @@map("pv_analysis_review")
}

