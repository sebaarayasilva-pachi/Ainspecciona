model Organization {
  id          String             @id @default(uuid())
  slug        String             @unique @db.VarChar(64)
  name        String             @db.VarChar(191)
  rut         String?            @db.VarChar(32)
  type        OrganizationType   @default(OTHER)
  status      OrganizationStatus @default(ACTIVE)
  logoUrl     String?            @db.VarChar(512)
  /// Si true, miembros deben aceptar NDA en /app antes de usar productos.
  requiresNda Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  members  OrganizationMember[]
  products OrganizationProduct[]
  links    LegacyIdentityLink[]

  @@map("platform_organization")
}

model PlatformUser {
  id              String             @id @default(uuid())
  email           String             @unique @db.VarChar(191)
  fullName        String             @db.VarChar(191)
  passwordHash    String             @db.VarChar(255)
  status          PlatformUserStatus @default(ACTIVE)
  isPlatformAdmin Boolean            @default(false)
  ndaAcceptedAt   DateTime?
  ndaVersion      String?            @db.VarChar(64)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships OrganizationMember[]
  links       LegacyIdentityLink[]

  @@map("platform_user")
}

model OrganizationMember {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           PlatformUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(MEMBER)
  status         PlatformUserStatus     @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("platform_organization_member")
}

model OrganizationProduct {
  id             String                    @id @default(uuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        PlatformProductCode
  status         OrganizationProductStatus @default(ENABLED)
  plan           String?                   @db.VarChar(64)
  settings       Json?
  startedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([organizationId, product])
  @@index([product])
  @@map("platform_organization_product")
}

/// Puente PlatformUser ↔ usuario/tenant legacy de un producto.
model LegacyIdentityLink {
  id              String              @id @default(uuid())
  platformUserId  String
  platformUser    PlatformUser        @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         PlatformProductCode
  legacyTenantId  String              @db.VarChar(191)
  legacyUserId    String              @db.VarChar(191)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([platformUserId, product])
  @@index([product, legacyTenantId, legacyUserId])
  @@index([organizationId])
  @@map("platform_legacy_identity_link")
}
