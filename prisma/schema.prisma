enum AiFeedbackSource {
  PROPERTYCHECK
  AINSPECTA
  POSTVENTA
  /// Informes de entrega de obra nueva (mirada fabricación/terminaciones, ej. PDFs históricos)
  ENTREGA
}

enum AiFeedbackStatus {
  draft
  pending_review
  approved
  rejected
  archived
}

/// Borrador de aprendizaje Aintelligence (correcciones humanas antes de aprobar en KB).
model AiFeedback {
  id                   String           @id @default(uuid())
  tenantId             String?
  source               AiFeedbackSource @default(PROPERTYCHECK)
  status               AiFeedbackStatus @default(draft)

  externalFeedbackId   String           @db.VarChar(128)
  externalInspectionId String           @db.VarChar(128)
  captureId            String           @db.VarChar(128)
  planItemId           String           @db.VarChar(128)
  sequence             Int?

  kpiKey               String?          @db.VarChar(64)
  photoPlan            Json?
  analyzeContext       Json?
  aiSnapshot           Json
  humanLabel           Json
  reviewer             Json?

  imagePath            String?          @db.VarChar(512)
  imageSha256          String?          @db.VarChar(64)
  imageMimeType        String?          @db.VarChar(64)
  payloadFingerprint   String?          @db.VarChar(64)

  idempotencyKey       String?          @db.VarChar(128)

  submittedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([source, externalFeedbackId])
  @@index([tenantId])
  @@index([status])
  @@index([source, externalInspectionId])
