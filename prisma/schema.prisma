datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PropertyType {
  HOUSE
  DEPARTMENT
}

enum FloorType {
  CONCRETE
  WOOD
  MIXED
}

enum PropertyAgeRange {
  LESS_THAN_10_YEARS
  BETWEEN_10_AND_30_YEARS
  MORE_THAN_30_YEARS
}

enum CaseStatus {
  DRAFT
  IN_PROGRESS
  DONE
  PENDING_APPROVAL
  CANCELLED
}

enum SlotStatus {
  PENDING
  UPLOADED
  ANALYZED
  REJECTED
  NOT_CAPTURABLE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_USER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum CreditTransactionType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  legalName String?
  rut       String?
  passwordHash String?
  email     String?
  phone     String?
  /// Logo de la corredora (URL pública GCS/local).
  logoUrl   String?      @db.VarChar(512)
  logoWhiteUrl String?   @db.VarChar(512)
  facturacionJson Json?  // Razón social, RUT, dirección, comuna, ciudad, giro, email (para boleta/factura)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  mpSubscriptionId    String?  @unique @db.VarChar(64)
  subscriptionStatus  String?  @db.VarChar(32)  // pending | authorized | paused | cancelled
  subscriptionExpiresAt DateTime?
  trialSubscriptionId String?  @unique @db.VarChar(64)
  trialStatus         String?  @db.VarChar(32) // active | converted | expired | blocked | cancelled
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  trialConvertedAt    DateTime?
  trialCancelledAt    DateTime?
  trialRealInspectionUsedAt DateTime?
  trialBlockedReason  String?  @db.VarChar(255)
  trialEligibilityKey String?  @db.VarChar(191) // rutNorm|emailDomain
  trialAutoCharge     Boolean  @default(false)
  trialSource         String?  @db.VarChar(64)
  referralPartnerId   String?
  referralPartner     ReferralPartner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  referralCodeSnapshot String? @db.VarChar(64)
  trialPartnerBenefitsAt DateTime?
  peerReferralCode     String?  @unique @db.VarChar(32)
  /// Tras recuperación por email (clave temporal): el panel exige definir clave nueva antes de continuar.
  mustChangePassword   Boolean  @default(false)

  users        User[]
  cases        Case[]
  owners       Owner[]
  properties   Property[]
  slots        Slot[]
  photos       Photo[]
  captureTokens CaptureToken[]
  creditAccount TenantCredit?
  creditTransactions CreditTransaction[]
  magicLinkTokens MagicLinkToken[]
  partnerCommissionAccruals PartnerCommissionAccrual[]
  presencialOrders        PresencialOrder[]
  peerReferralsMade       PeerReferralAttribution[] @relation("PeerReferrer")
  peerReferralReceived    PeerReferralAttribution?  @relation("PeerReferred")
  ambassadorReferralReceived AmbassadorReferralAttribution? @relation("AmbassadorReferredTenant")
  whatsappConversations   WhatsAppConversation[]
  simpleFacturaEmissions  SimpleFacturaEmission[]
  promoRedemption         PromoRedemption?

  @@index([rut])
  @@index([mpSubscriptionId])
  @@index([trialSubscriptionId])
  @@index([trialStatus])
  @@index([trialEndsAt])
  @@index([trialEligibilityKey])
  @@index([referralPartnerId])
}

/// Códigos promo para 1 inspección gratis (sin suscripción $39.990).
model PromoCode {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(64)
  active    Boolean  @default(true)
  credits   Int      @default(1)
  label     String?  @db.VarChar(191)
  createdAt DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String   @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rutNorm     String   @unique @db.VarChar(32)
  createdAt   DateTime @default(now())

  @@index([promoCodeId])
}

model PeerReferralAttribution {
  id               String   @id @default(uuid())
  referrerTenantId String
  referrerTenant   Tenant   @relation("PeerReferrer", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenantId String   @unique
  referredTenant   Tenant   @relation("PeerReferred", fields: [referredTenantId], references: [id], onDelete: Cascade)
  peerCodeUsed     String   @db.VarChar(32)
  createdAt        DateTime @default(now())

  @@index([referrerTenantId])
}

model ReferralPartner {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(32)
  name             String
  type             String   @db.VarChar(32)
  contactEmail     String?  @db.VarChar(255)
  payoutJson       Json?
  commissionRate   Decimal  @default(0.15) @db.Decimal(6, 4)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenants          Tenant[]
  commissionAccruals PartnerCommissionAccrual[]
}

model PartnerCommissionAccrual {
  id                   String          @id @default(uuid())
  referralPartnerId    String
  referralPartner      ReferralPartner @relation(fields: [referralPartnerId], references: [id], onDelete: Cascade)
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source               String          @db.VarChar(32)
  mercadopagoPaymentId String          @unique @db.VarChar(64)
  grossAmountClp       Int
  commissionRate     Decimal         @db.Decimal(6, 4)
  commissionAmountClp  Int
  status               String          @default("ACCRUED") @db.VarChar(16)
  createdAt            DateTime        @default(now())

  @@index([referralPartnerId])
  @@index([tenantId])
  @@index([createdAt])
}

model MagicLinkToken {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([expiresAt])
  @@index([token])
}

model TenantCredit {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model CreditTransaction {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Int                 // positivo = ingreso, negativo = consumo
  type        CreditTransactionType
  caseId      String?
  description String?             @db.VarChar(500)
  createdAt   DateTime            @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

model User {
  id        String     @id @default(uuid())
  tenantId  String?
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email     String     @unique
  fullName  String
  phone     String?
  passwordHash String?
  role      UserRole   @default(TENANT_USER)
  status    UserStatus @default(PENDING)
  invitedAt DateTime?
  activatedAt DateTime?
  createdAt DateTime   @default(now())
  /// Tras recuperación por email (clave temporal): la app exige definir clave nueva antes del dashboard.
  mustChangePassword Boolean @default(false)
  /// Si true, las inspecciones creadas por este usuario desde la app ejecutiva consumen 1 crédito al crear (sin aprobación admin).
  autoApproveInspections Boolean @default(false)

  activationTokens ActivationToken[]
  assignedCases Case[] @relation("AssignedCases")

  @@index([tenantId])
}

model ActivationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Case {
  id           String       @id @default(uuid())
  shortId      String?      @unique  // 8 caracteres para URLs (ej. informe, certificado)
  tenantId     String?
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignedUserId String?
  assignedUser   User?      @relation("AssignedCases", fields: [assignedUserId], references: [id], onDelete: SetNull)
  propertyId   String?
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyType PropertyType
  bathroomsCount Int           @default(1)
  bedroomsCount  Int           @default(1)
  propertyAgeRange PropertyAgeRange?
  bedrooms     Int
  bathrooms    Int
  yearBuilt    Int?
  floorType    FloorType
  hasPatio     Boolean      @default(false)
  hasAttic     Boolean      @default(false)
  hasLaundry   Boolean      @default(false)
  hasElevator  Boolean      @default(false)
  hasParking   Boolean      @default(false)
  hasGreenCertificate Boolean @default(false)
  /// Casa: reja o cerramiento en acceso de entrada (opcional en plan de fotos).
  hasEntranceGrille Boolean @default(false)
  planVersion  String       @default("v1")
  status       CaseStatus   @default(DRAFT)
  /// Token para que el admin apruebe/rechace desde el email (sin sesión).
  approvalToken          String?   @unique @db.VarChar(64)
  approvalTokenExpiresAt DateTime?
  createdAt    DateTime     @default(now())
  executiveSummary String?  @db.LongText
  reviewStatus    String?  @db.VarChar(32)  // pending_review | approved (Beta: Paulo revisa antes de enviar)
  reviewedAt      DateTime?
  reviewerEmail   String?  @db.VarChar(255)
  /// Email “informe listo” al ejecutivo (idempotente; solo tenants Business).
  executiveReportNotifiedAt DateTime?

  // SSOT: Score persistido después del análisis (una sola fuente de verdad)
  finalScore      Int?      // Score 0-100 calculado al completar caso
  finalBadge      String?   @db.VarChar(16) // GREEN | YELLOW | RED | GRAY
  scoreVersion    String?   @db.VarChar(32) // SCORING_V2_2_KPI
  kpiScores       Json?     // Detalle por KPI: {MUROS_PINTURA: 85, SANITARIOS: 50, ...}
  scoredAt        DateTime? // Timestamp del cálculo

  // Starter: contacto y vínculo con pago
  contactEmail         String?  @db.VarChar(255)
  contactName          String?  @db.VarChar(255)
  contactRut           String?  @db.VarChar(32)
  mercadopagoPaymentId String?  @unique @db.VarChar(64)
  facturacionJson      Json?    // Razón social, RUT, dirección, comuna, ciudad, giro, email

  slots        Slot[]
  photos       Photo[]
  captureTokens CaptureToken[]
  presencialOrders PresencialOrder[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([assignedUserId])
}

// Proveedor de inspección presencial (ej. Paulo Inspecciona)
model Supplier {
  id                   String   @id @default(uuid())
  code                 String   @unique @db.VarChar(64)
  name                 String   @db.VarChar(255)
  legalName            String?  @db.VarChar(255)
  rut                  String?  @db.VarChar(32)
  address              String?  @db.VarChar(512)
  codigo               String?  @db.VarChar(64)
  email                String?  @db.VarChar(255)
  phone                String?  @db.VarChar(64)
  contactName          String?  @db.VarChar(255)
  notes                String?  @db.Text
  active               Boolean  @default(true)
  isDefaultPresencial  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  presencialOrders PresencialOrder[]

  @@index([active])
  @@index([isDefaultPresencial])
}

// OC / solicitud tras pago de inspección presencial (Mercado Pago)
model PresencialOrder {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId               String?
  case                 Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  supplierId           String
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  mercadopagoPaymentId String   @unique @db.VarChar(64)
  amountClp            Int?
  surfaceM2            Int?
  addressSnapshot      String?  @db.Text
  status               String   @default("PENDING_OC") @db.VarChar(32)
  ocNumber             String?  @db.VarChar(64)
  adminNotes           String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
  @@index([caseId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model Owner {
  id         String     @id @default(uuid())
  tenantId   String?
  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  fullName   String
  rut        String?    @unique
  createdAt  DateTime   @default(now())

  properties Property[]

  @@index([tenantId])
}

model Property {
  id             String   @id @default(uuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  rol            String?
  address        String?
  operationType  String?
  surface        String?

  createdAt      DateTime @default(now())

  cases          Case[]

  @@index([ownerId])
  @@index([tenantId])
}

model Slot {
  id           String     @id @default(uuid())
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  caseId       String
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Opcional: referencia a la ultima foto subida para este slot
  photoId      String?
  photo        Photo?     @relation("SlotLastPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  photos       Photo[]    @relation("SlotPhotos")

  slotCode     String
  title        String
  instructions String   @db.Text
  required     Boolean    @default(true)
  orderIndex   Int
  status       SlotStatus @default(PENDING)

  // Resultado del analisis (ultima ejecucion)
  analysisCode     String?
  analysisSeverity String?
  analysisConfidence Float?
  analysisMessage  String?   @db.Text
  analysisDebug    Json?
  analyzedAt       DateTime?

  createdAt    DateTime   @default(now())

  @@index([caseId])
  @@index([slotCode])
  @@index([photoId])
  @@index([tenantId])
}

model Photo {
  id        String   @id @default(uuid())

  slotId    String
  slot      Slot     @relation("SlotPhotos", fields: [slotId], references: [id], onDelete: Cascade)
  // Relacion inversa para "ultima foto" en Slot
  asLastForSlots Slot[] @relation("SlotLastPhoto")

  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  filePath  String
  fileName  String
  mimeType  String
  fileSize  Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([slotId])
  @@index([caseId])
  @@index([tenantId])
}

model CaptureToken {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([expiresAt])
  @@index([tenantId])
}

/// Tiempo de respuesta del servidor en POST /api/capture/.../capture (subida + análisis en backend).
model CaptureUploadMetric {
  id         String   @id @default(uuid())
  caseId     String
  tenantId   String?
  slotId     String
  durationMs Int
  passed     Boolean
  imageBytes Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([caseId])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  /// 'tenant' | 'exec' | 'postventa' | 'entrega' | 'inout' | 'platform' | 'control'
  /// Para type=platform|control: userId=PlatformUser.id, tenantId=Organization.id
  type      String
  tenantId  String?
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model PageView {
  id        String   @id @default(uuid())
  path      String   @db.VarChar(512)
  referrer  String?  @db.VarChar(1024)
  ua        String?  @db.VarChar(512)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

// WhatsApp (360dialog / Cloud API compatible): conversaciones y deduplicación de webhooks
model WhatsAppConversation {
  id          String   @id @default(uuid())
  waId        String   @unique @db.VarChar(32)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  state       String   @default("default") @db.VarChar(64)
  handoffAt   DateTime?
  lastInboundAt DateTime?
  /// Nombre que dio el usuario (extracción + confirmación en prompt; no inventar otro).
  contactName String?  @db.VarChar(120)
  /// Correo capturado desde el mensaje (lead / seguimiento; extracción automática).
  contactEmail String? @db.VarChar(255)
  /// Ya se ofreció la asesoría gratuita / enlace agendar (evitar repetir en cada turno).
  advisoryOffered Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages WhatsAppMessage[]

  @@index([tenantId])
  @@index([lastInboundAt])
}

model WhatsAppMessage {
  id             String   @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      WhatsAppMessageDirection
  body           String?  @db.Text
  externalId     String?  @unique @db.VarChar(128)
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model WhatsAppProcessedEvent {
  id         String   @id @default(uuid())
  externalId String   @unique @db.VarChar(128)
  createdAt  DateTime @default(now())
}

// Starter: datos capturados antes del pago (contacto + facturación)
model PendingStarterPayment {
  id               String    @id @default(uuid())
  contactNombre    String    @db.VarChar(120)
  contactApellido  String    @db.VarChar(120)
  contactRut       String    @db.VarChar(32)
  contactEmail     String    @db.VarChar(255)
  necesitaFactura  Boolean   @default(false)
  facturaRazonSocial String? @db.VarChar(255)
  facturaRut       String?   @db.VarChar(32)
  facturaDireccion String?   @db.VarChar(255)
  facturaComuna    String?   @db.VarChar(120)
  facturaCiudad    String?   @db.VarChar(120)
  facturaGiro      String?   @db.VarChar(120)
  facturaEmail     String?   @db.VarChar(255)
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
}

/// Embajadores del programa (awards): código único (manual en admin o auto: primer nombre + correlativo, ej. maria1).
model Ambassador {
  id        String   @id @default(uuid())
  fullName  String   @db.VarChar(191)
  rut       String   @db.VarChar(32)
  email     String   @db.VarChar(191)
  phone     String?  @db.VarChar(32)
  code      String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())

  referrals AmbassadorReferralAttribution[]

  @@index([email])
  @@index([rut])
}

/// Referido (tenant) asociado a un embajador al inscribirse con su código (trial / checkout).
model AmbassadorReferralAttribution {
  id                 String    @id @default(uuid())
  ambassadorId       String
  ambassador         Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredTenantId   String    @unique
  referredTenant     Tenant    @relation("AmbassadorReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)
  codeSnapshot       String    @db.VarChar(64)
  firstAccreditedAt  DateTime?
  /// Fin del período de comisión (3 meses calendario desde el mes del primer pago acreditado).
  commissionUntil    DateTime?
  createdAt          DateTime  @default(now())

  commissionLines AmbassadorCommissionLine[]

  @@index([ambassadorId])
}

/// Líneas idempotentes por pago MP: neto liquidado y comisión 30% (base antes de retención embajador).
/// Registro idempotente de emisión DTE vía SimpleFactura (boleta/factura electrónica).
model SimpleFacturaEmission {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mercadopagoPaymentId String   @unique @db.VarChar(96)
  tipoDte              Int
  status               String   @db.VarChar(16)
  folio                Int?
  trackId              String?  @db.VarChar(128)
  responseJson         Json?
  errorMessage         String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
}

model AmbassadorCommissionLine {
  id                   String   @id @default(uuid())
  attributionId        String
  attribution          AmbassadorReferralAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  mercadopagoPaymentId String   @unique @db.VarChar(96)
  kind                 String   @db.VarChar(16)
  netAmountClp         Int
  accreditedAt         DateTime
  yearMonth            String   @db.VarChar(7)
  plan                 String?  @db.VarChar(64)
  commissionClp        Int
  createdAt            DateTime @default(now())

  @@index([attributionId, yearMonth])
  @@index([yearMonth])
}

// --- Postventa inmobiliaria (Pv*) — aislado de Tenant/Case inspecciones ---

enum PvTenantStatus {
  ACTIVE
  INACTIVE
}

enum PvCaptureSlotStatus {
  pending
  uploaded
  skipped
  analyzed
  rejected
}

model PvTenant {
  id        String         @id @default(uuid())
  slug      String         @unique @db.VarChar(64)
  name      String         @db.VarChar(191)
  status    PvTenantStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  projects PvProject[]
  owners   PvOwner[]
  tickets  PvTicket[]
  users    PvUser[]

  @@map("pv_tenant")
}

enum PvUserRole {
  ADMIN
  EXECUTIVE
  OPERATOR
  INSPECTOR
}

enum PvUserStatus {
  ACTIVE
  DISABLED
}

model PvUser {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       PvTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String       @unique @db.VarChar(191)
  fullName     String       @db.VarChar(191)
  role         PvUserRole   @default(OPERATOR)
  status       PvUserStatus @default(ACTIVE)
  passwordHash String       @db.VarChar(255)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  defaultProjects PvProject[] @relation("PvProjectDefaultInspector")
  assignedTickets PvTicket[]  @relation("PvTicketAssignee")

  @@index([tenantId])
  @@map("pv_user")
}

model PvProject {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             PvTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String    @db.VarChar(191)
  slug               String    @db.VarChar(64)
  address            String?   @db.VarChar(255)
